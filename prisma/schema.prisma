generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Participant {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(60)
  university  String   @db.VarChar(100)
  department  String   @db.VarChar(100)
  studentId   String   @db.VarChar(50)  @map("student_id")
  phone       String   @db.VarChar(20)
  email       String   @db.VarChar(100)
  grade       String   @db.VarChar(20)
  gender      String   @db.VarChar(10)
  createdAt   DateTime @default(now())   @map("created_at")

  fields      ParticipantField[]
  languages   ParticipantLanguage[]
  experience  Experience?
  details     ParticipantDetail?

  @@map("tb_participants")
}

model Field {
  id           Int                @id @default(autoincrement())
  name         String             @db.VarChar(50)
  participants ParticipantField[]

  @@map("tb_fields")
}

model ParticipantField {
  participantId Int         @map("participant_id")
  fieldId       Int         @map("field_id")
  customText    String?     @db.VarChar(100) @map("custom_text")

  participant   Participant @relation(fields: [participantId], references: [id])
  field         Field       @relation(fields: [fieldId],       references: [id])

  @@id([participantId, fieldId])
  @@map("tb_participant_fields")
}

model Experience {
  participantId       Int         @id @map("participant_id")
  hackathonExperience Boolean?    @map("hackathon_experience")
  hackathonName       String?     @db.VarChar(255) @map("hackathon_name")
  awardExperience     Boolean?    @map("award_experience")
  awardCompetition    String?     @db.VarChar(255) @map("award_competition")
  awardName           String?     @db.VarChar(255) @map("award_name")
  devExperience       Boolean?    @map("dev_experience")

  participant         Participant @relation(fields: [participantId], references: [id])

  @@map("tb_experiences")
}

model Language {
  id           Int                   @id @default(autoincrement())
  name         String?               @db.VarChar(50)
  participants ParticipantLanguage[]

  @@map("tb_languages")
}

model ParticipantLanguage {
  participantId Int         @map("participant_id")
  languageId    Int         @map("language_id")
  customText    String?     @db.VarChar(100) @map("custom_text")

  participant   Participant @relation(fields: [participantId], references: [id])
  language      Language    @relation(fields: [languageId],    references: [id])

  @@id([participantId, languageId])
  @@map("tb_participant_languages")
}

model ParticipantDetail {
  participantId       Int         @id @map("participant_id")
  tools               String?     @db.Text
  devExperienceDetail String?     @db.Text @map("dev_experience_detail")
  aiExperienceDetail  String?     @db.Text @map("ai_experience_detail")

  participant         Participant @relation(fields: [participantId], references: [id])

  @@map("tb_participant_details")
}
